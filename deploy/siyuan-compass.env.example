## Copy to /etc/siyuan-compass.env and replace every placeholder.
## Keep this file free of real keys, passwords, and portal session secrets.

LLM_PROVIDER=deepseek
DEEPSEEK_BASE_URL=https://models.sjtu.edu.cn/api/v1
DEEPSEEK_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=600
LLM_MAX_CONCURRENCY=3
LLM_MAX_REQUESTS_PER_MINUTE=8
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=10000

# The portal's /etc/course-ai.env may provide AI_API_KEY, AI_API_BASE, and
# AI_MODEL.  Those values are supported as fallbacks by the backend.

LOCAL_AUTH_ENABLED=false
PORTAL_SESSION_SECRET=replace-with-portal-secret
PORTAL_SESSION_COOKIE_NAME=session
PORTAL_SESSION_MAX_AGE_SECONDS=604800
PORTAL_LOGIN_URL=https://ai4edu.sjtu.edu.cn/auth/jaccount/login
PORTAL_LOGOUT_URL=https://ai4edu.sjtu.edu.cn/auth/logout
PUBLIC_APP_URL=https://ai4edu.sjtu.edu.cn
APP_BASE_PATH=/shengya
FRONTEND_ORIGINS=https://ai4edu.sjtu.edu.cn

REPORT_GENERATION_DAILY_LIMIT=0
REPORT_GENERATION_QUOTA_TIMEZONE=Asia/Shanghai
GENERATION_WORKER_COUNT=3
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_HEARTBEAT_SECONDS=30
GENERATION_JOB_RETENTION_DAYS=30
ASSESSMENT_DRAFT_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=180

AUTH_SECRET=replace-with-a-long-random-secret
DATABASE_URL=postgresql://siyuan_compass:replace-with-database-password@127.0.0.1:5432/siyuan_compass
