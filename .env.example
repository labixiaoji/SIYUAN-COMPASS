LLM_PROVIDER=deepseek

KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://models.sjtu.edu.cn/api/v1
DEEPSEEK_MODEL=deepseek-chat

# Optional shared school gateway aliases.  When set, AI_API_BASE and AI_MODEL
# override the corresponding DeepSeek endpoint/model; the API key falls back
# to AI_API_KEY when DEEPSEEK_API_KEY is empty.
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

LLM_TIMEOUT_SECONDS=600
LLM_MAX_CONCURRENCY=20
# 每分钟平滑启动模型请求；建议低于供应商硬限制以保留余量。
LLM_MAX_REQUESTS_PER_MINUTE=8
LLM_MAX_RETRIES=5
# 每次画像/报告模型请求的最大输出 Token。
LLM_MAX_OUTPUT_TOKENS=40000

# 本地前端开发服务以及 Docker/Nginx 前端允许的访问来源。
# 生产环境请替换为实际公网地址。
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# 本地 Vite 开发服务器从根目录 .env 读取此配置。
# Docker 前端构建仍通过 docker-compose.yml 使用 /api。
VITE_API_BASE_URL=http://localhost:8000/api
VITE_BASE_PATH=/
VITE_ENABLE_LOCAL_AUTH=true

# 生成方式：openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-64-random-characters
AUTH_TOKEN_HOURS=72
AUTH_COOKIE_NAME=siyuan_session
LOCAL_AUTH_ENABLED=true

# Direct jAccount OIDC Authorization Code configuration. Register the redirect
# URI exactly as written in the SJTU Developer Platform.
JACCOUNT_CLIENT_ID=
JACCOUNT_CLIENT_SECRET=
JACCOUNT_AUTHORIZE_URL=https://jaccount.sjtu.edu.cn/oauth2/authorize
JACCOUNT_TOKEN_URL=https://jaccount.sjtu.edu.cn/oauth2/token
JACCOUNT_LOGOUT_URL=https://jaccount.sjtu.edu.cn/oauth2/logout
JACCOUNT_ISSUER=https://jaccount.sjtu.edu.cn/oauth2/
JACCOUNT_REDIRECT_URI=http://localhost:8000/api/auth/jaccount/callback
JACCOUNT_SCOPE=openid
JACCOUNT_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
JACCOUNT_HTTP_TIMEOUT_SECONDS=15
PUBLIC_APP_URL=http://localhost:5173
APP_BASE_PATH=/

# 报告生成配额和持久化 PostgreSQL 任务 Worker 配置。
# 0 表示关闭每日配额；租约时间应长于心跳间隔。
REPORT_GENERATION_DAILY_LIMIT=0
REPORT_GENERATION_QUOTA_TIMEZONE=Asia/Shanghai
GENERATION_WORKER_COUNT=20
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_HEARTBEAT_SECONDS=30
GENERATION_JOB_RETENTION_DAYS=30
ASSESSMENT_DRAFT_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=180

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=系统管理员

POSTGRES_DB=siyuan_compass
POSTGRES_USER=siyuan
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# 本地 Docker 使用 8080；如果由其他反向代理或云负载均衡处理 HTTPS，则使用 80。
HTTP_PORT=8080
