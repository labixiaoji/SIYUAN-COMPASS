LLM_PROVIDER=deepseek

KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://models.sjtu.edu.cn/api/v1
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=600
LLM_MAX_CONCURRENCY=20
# 每分钟平滑启动模型请求；当前 c0f762f 需配合对应限流代码才会生效。
LLM_MAX_REQUESTS_PER_MINUTE=8
LLM_MAX_RETRIES=5
# 每次画像/报告模型请求的最大输出 Token。
LLM_MAX_OUTPUT_TOKENS=40000

# 本地前端开发服务以及 Docker/Nginx 前端允许的访问来源。
# 生产环境请替换为实际公网地址。
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# 本地 Vite 开发服务器从根目录 .env 读取此配置。
# Docker 前端构建仍通过 docker-compose.yml 使用 /api。
VITE_API_BASE_URL=http://localhost:8000/api

# 生成方式：openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-64-random-characters
AUTH_TOKEN_HOURS=72

# 报告生成配额和持久化 PostgreSQL 任务 Worker 配置。
# 0 表示关闭每日配额；租约时间应长于心跳间隔。
REPORT_GENERATION_DAILY_LIMIT=0
REPORT_GENERATION_QUOTA_TIMEZONE=Asia/Shanghai
GENERATION_WORKER_COUNT=20
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_HEARTBEAT_SECONDS=30
GENERATION_JOB_RETENTION_DAYS=30
ASSESSMENT_DRAFT_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=180

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=系统管理员

POSTGRES_DB=siyuan_compass
POSTGRES_USER=siyuan
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# 本地 Docker 使用 8080；如果由其他反向代理或云负载均衡处理 HTTPS，则使用 80。
HTTP_PORT=8080
