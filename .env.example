LLM_PROVIDER=kimi

KIMI_API_KEY=replace-with-your-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

LLM_TIMEOUT_SECONDS=180

# Optional XFYUN file-transcription large model. Keep disabled until the
# school's privacy review and XFYUN service authorization are complete.
SPEECH_PROVIDER=disabled
SPEECH_XFYUN_APP_ID=
SPEECH_XFYUN_API_KEY=
SPEECH_XFYUN_API_SECRET=
SPEECH_XFYUN_BASE_URL=https://office-api-ist-dx.iflyaisol.com
SPEECH_XFYUN_LANGUAGE=autodialect
SPEECH_XFYUN_DOMAIN=edu
SPEECH_XFYUN_POLL_INTERVAL_SECONDS=1.5
SPEECH_XFYUN_POLL_TIMEOUT_SECONDS=120
SPEECH_TIMEOUT_SECONDS=30
SPEECH_MAX_FILE_MB=10
SPEECH_DAILY_LIMIT=20
SPEECH_QUOTA_TIMEZONE=Asia/Shanghai

# Local frontend dev server and Docker/Nginx frontend origins.
# For production, replace these with your real public URL.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost

# Local Vite dev server reads this from the root .env.
# Docker frontend builds still use /api through docker-compose.yml.
VITE_API_BASE_URL=http://localhost:8000/api

# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-at-least-64-random-characters
AUTH_TOKEN_HOURS=72

# Report generation quota and durable PostgreSQL job worker.
# 0 disables the daily quota. Keep the lease longer than the heartbeat interval.
REPORT_GENERATION_DAILY_LIMIT=3
REPORT_GENERATION_QUOTA_TIMEZONE=Asia/Shanghai
GENERATION_JOB_LEASE_SECONDS=300
GENERATION_JOB_HEARTBEAT_SECONDS=30
GENERATION_JOB_RETENTION_DAYS=30
ASSESSMENT_DRAFT_RETENTION_DAYS=30
ADMIN_AUDIT_RETENTION_DAYS=180

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_DISPLAY_NAME=系统管理员

POSTGRES_DB=siyuan_compass
POSTGRES_USER=siyuan
POSTGRES_PASSWORD=replace-with-a-strong-database-password
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# Use 8080 for local Docker. Use 80 when another reverse proxy or cloud load balancer handles HTTPS.
HTTP_PORT=8080
